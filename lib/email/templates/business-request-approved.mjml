<mjml>
  <mj-head>
    <mj-title>{{subject}}</mj-title>
    <mj-preview>{{preview}}</mj-preview>
    <mj-font name="Manrope" href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="Manrope, Helvetica, Arial, sans-serif" />
      <mj-text color="#003239" font-size="15px" line-height="1.65" padding="0" />
      <mj-button
        background-color="#003239"
        color="#ffffff"
        border-radius="6px"
        font-size="15px"
        font-weight="700"
        inner-padding="14px 28px"
        padding="8px 0 0"
      />
      <mj-section padding="0" />
      <mj-column padding="0" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#faf9f8" width="600px">
    <mj-section background-color="#003239" padding="28px 32px">
      <mj-column>
        <mj-text align="center" color="#ffffff" font-size="22px" font-weight="700">
          WhereTo30A
        </mj-text>
        <mj-text align="center" color="#6cb2b5" font-size="12px" font-weight="500" padding-top="6px">
          Scenic Highway · Florida
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="36px 32px 28px">
      <mj-column>
        <mj-text font-size="22px" font-weight="700" line-height="1.35" padding-bottom="16px">
          Your request was approved
        </mj-text>
        <mj-text padding-bottom="14px">
          Good news — your request for <strong>{{businessTitle}}</strong> has been approved.
        </mj-text>
        <mj-text color="#5a6b6d" padding-bottom="14px">
          {{approvalDetail}}
        </mj-text>
        {{adminNotesBlock}}
        {{ctaBlock}}
      </mj-column>
    </mj-section>

    <mj-section background-color="#f4f3f2" padding="24px 32px 32px">
      <mj-column>
        <mj-text align="center" color="#5a6b6d" font-size="13px" line-height="1.55">
          Questions? Reply to this email or write
          <a href="mailto:hello@whereto30a.com" style="color:#003239;text-decoration:underline;">hello@whereto30a.com</a>
        </mj-text>
        <mj-text align="center" color="#8a9698" font-size="12px" padding-top="12px">
          © WhereTo30A · <a href="{{siteUrl}}" style="color:#8a9698;">whereto30a.com</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
