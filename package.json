    "content:migrate:db": "npx tsx scripts/migrate-pages-to-content-entries.ts",
    "supabase:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "supabase:types:remote": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" > lib/supabase/database.types.ts",
    "diagnose:supabase": "npx tsx scripts/diagnose-supabase.ts"
  },
