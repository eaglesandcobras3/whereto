    "gray-matter": "^4.0.3",
    "imagesloaded": "^5.0.0",
    "masonry-layout": "^4.2.2",
    "nanoid": "^5.1.7",
    "next": "16.2.0",
    "openai": "^6.33.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/imagesloaded": "^4.1.7",
    "@types/masonry-layout": "^4.2.8",
    "@types/node": "^20",
